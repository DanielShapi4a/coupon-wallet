# Copy to .env and set the public URL of the local server (stage A in ADR-003: a free tunnel to http://localhost:3000).
EXPO_PUBLIC_API_URL=https://example.trycloudflare.com
# The Web OAuth client ID from Google Cloud, the same value the server uses. Not a secret.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
