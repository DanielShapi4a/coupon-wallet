{
  "expo": {
    "name": "Coupon Wallet",
    "slug": "coupon-wallet",
    "scheme": "couponwallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "io.github.danielshapi4a.couponwallet.dev",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "react-native-libsodium",
      "expo-sqlite",
      ["expo-build-properties", { "android": { "minSdkVersion": 34 } }]
    ],
    "owner": "danielshapi4a",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e28a52f6-f7fb-45e8-8333-82d1652db151"
      }
    }
  }
}
