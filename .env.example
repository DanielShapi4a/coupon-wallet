# Copy to .env (git-ignored) for docker compose.
# The Web OAuth client ID from Google Cloud: the audience of the app's Google ID tokens. Not a secret.
GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Signs the server's access tokens. Any random string of 32+ characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
